// ========================================================================
// TMCM-3351  —  3-AXIS VERTICAL LIFT STATE MACHINE
// Host: Julia (tmcl_control_layer.jl).  Auto-start: GP#77 Bank0 = 1.
// Julia writes GP Bank 2 params, sets GP10 to trigger a routine,
// then polls GP10 == 0 (wait_for_idle) to detect completion.
// All defaults and GP address constants are in tmcl_control_layer.jl.
//
// GP10 COMMAND REGISTER
//    0  Idle (written by board on exit)
//    1  PowerOn          — apply motion params (GP 4/5/6/7/17/210) to all axes; sync encoder→actual→target
//    2  StartInit        — apply closed-loop PID params (GP 108–126/212/213) to all axes
//    3  DisableClosedLoop
//    4  EnableClosedLoop
//    5  ReferenceZero    — zero encoder at current position
//    6  CalibrateAxis0   — descend axis 0 to block; save encoder pos → GP 53
//    7  CalibrateAxis1   — descend axis 1 to block; save encoder pos → GP 54
//    8  CalibrateAxis2   — descend axis 2 to block; save encoder pos → GP 55
//    9  StartMove        — move all axes to (CALIB_POS − GP0); speed from GP4
//   10  PowerOff         — MST all axes, disable CL, zero currents
//   11  EnterMeasurement — MST, sync target, zero run/hold currents
//   12  ExitMeasurement  — re-sync target, restore currents from GP 6/7
//   13  MoveAxis0        — move axis 0 to absolute encoder pos (GP0 = target)
//   14  MoveAxis1
//   15  MoveAxis2
//   16  SimultaneousCalibration — all 3 axes descend together, each MST'd on stall
//   17  MoveAxis0AboveCalib — move axis 0 to (CALIB_POS_AXIS0 − offset); Julia writes abs target to GP59
//   18  MoveAxis1AboveCalib — move axis 1 to (CALIB_POS_AXIS1 − offset); Julia writes abs target to GP60
//   19  MoveAxis2AboveCalib — move axis 2 to (CALIB_POS_AXIS2 − offset); Julia writes abs target to GP61
//   99  Error/Jam        — set by EmergencyStop; persists until Julia clears it
//  100  Ping             — no-op; clears GP10 to 0 so Julia can detect the program is running
//  999  EndLoop          — MST all axes, STOP
// ========================================================================


// ========================================================================
// --- VARIABLES IN BANK 2---
// ========================================================================
// The first 56 variables can also be stored permanently in the EEPROM. After booting, their values are
//automatically restored to the RAM.
Target_Pos = 0
Actual_Pos = 1
Target_Speed = 2
Actual_Speed = 3
Max_Speed = 4
Max_Acceleration = 5
Max_Current = 6
Standby_Current = 7
TMCM_Command = 10
Max_Deceleration = 17

CALIB_POS_AXIS0 = 53
CALIB_POS_AXIS1 = 54
CALIB_POS_AXIS2 = 55

CALIB_DONE_AXIS0 = 56   // temporary done flag for SimultaneousCalibration (0/1, cleared on exit)
CALIB_DONE_AXIS1 = 57
CALIB_DONE_AXIS2 = 58

MOVE_TARGET_AXIS0 = 59  // absolute move target axis 0 (written by Julia: calib0 - offset)
MOVE_TARGET_AXIS1 = 60  // absolute move target axis 1
MOVE_TARGET_AXIS2 = 61  // absolute move target axis 2


CLgamma_Vmin = 108
CLgamma_Vmax = 109
CL_Maxgamma = 110
CL_Beta = 111
CL_Currentmin = 113
CL_Currentmax = 114
CL_Correction_VelocityP = 115
CL_Correction_VelocityI = 116
CL_Correction_VelocityI_Clipping = 117
CL_Correction_VelocityDV_Clock = 118
CL_Correction_VelocityDV_Clipping = 119
CL_Upscale_Delay = 120
CL_Downscale_Delay = 121
CL_Correction_Pos = 124
CLmax_Correction_Tolerance = 125
CL_Startup = 126
Pos_Window = 134
Encoder_Pos = 209
Encoder_Resolution = 210
Max_Encoder_Deviation = 212
Max_Velocity_Deviation = 213


// ========================================================================
// --- INITIALIZATION --- ALL GP VALUES ARE SET BY JULIA BEFORE ANY ROUTINE
// ========================================================================
// Default values and GP address constants live in tmcl_control_layer.jl
// (DEFAULT_* / GP_* constants).  Julia writes every GP register it needs
// before firing GP_TMCM_COMMAND, so no SGP init is required here.
SGP TMCM_Command, 2, 0  // Safety reset: ensure command register starts idle
SGP 77, 0, 1            // Enable auto-start: run this program automatically after every power-up (stored in EEPROM)

// Safety init: runs on every program start (power cycle AND red-button restart).
// Disabling CL prevents the motor from driving to a stale AP0 target left over
// from a mid-move emergency stop. Zeroing currents is safe because the lead-screw
// spindles are self-locking — sleds hold position without motor current.
// Julia's startup! (power_on) will re-apply currents and re-enable CL.
SAP 129, 0, 0           // disable closed-loop axis 0
SAP 129, 1, 0           // disable closed-loop axis 1
SAP 129, 2, 0           // disable closed-loop axis 2
SAP 6, 0, 0             // zero run current axis 0
SAP 6, 1, 0             // zero run current axis 1
SAP 6, 2, 0             // zero run current axis 2
SAP 7, 0, 0             // zero standby current axis 0
SAP 7, 1, 0             // zero standby current axis 1
SAP 7, 2, 0             // zero standby current axis 2

// ========================================================================
// MAIN STATE MACHINE LOOP
// ========================================================================
MainLoop:
    GGP TMCM_Command, 2      // Read the State Machine register (GP 10). The controller is waiting for an external system (Julia) to write a number into GP 10 bank 2
    
    COMP 1                  // If Julia wrote '1', power on device
    JC EQ, PowerOn
    
    COMP 2
    JC EQ, StartInit

    COMP 3
    JC EQ, DisableClosedLoop

    COMP 4
    JC EQ, EnableClosedLoop

    COMP 5
    JC EQ, ReferenceZero

    COMP 6
    JC EQ, StartCalibrationAxis0

    COMP 7
    JC EQ, StartCalibrationAxis1

    COMP 8
    JC EQ, StartCalibrationAxis2

    COMP 9
    JC EQ, StartMove

    COMP 10
    JC EQ, PowerOff

    COMP 11
    JC EQ, EnterMeasurementMode

    COMP 12
    JC EQ, ExitMeasurementMode

    COMP 13
    JC EQ, MoveAxis0

    COMP 14
    JC EQ, MoveAxis1

    COMP 15
    JC EQ, MoveAxis2

    COMP 16
    JC EQ, SimultaneousCalibration

    COMP 17
    JC EQ, MoveAxis0AboveCalib

    COMP 18
    JC EQ, MoveAxis1AboveCalib

    COMP 19
    JC EQ, MoveAxis2AboveCalib

    //COMP 99
    //JC EQ, ErrorState

    COMP 100
    JC EQ, Ping

    COMP 999
    JC EQ, EndLoop

    WAIT TICKS, 0, 1
    
    JA MainLoop             // Otherwise, loop infinitely and wait

// ========================================================================
// 1. POWER ON
// ========================================================================
PowerOn:

    GGP Encoder_Resolution, 2
    AAP 210, 0
    AAP 210, 1
    AAP 210, 2
        
    GGP Max_Speed, 2 
    AAP 4,0
    AAP 4,1
    AAP 4,2

    GGP Max_Acceleration, 2
    AAP 5,0
    AAP 5,1
    AAP 5,2

    GGP Max_Deceleration, 2
    AAP 17,0
    AAP 17,1
    AAP 17,2

    GGP Max_Current, 2
    AAP 6,0
    AAP 6,1
    AAP 6,2

    GGP Standby_Current, 2
    AAP 7,0
    AAP 7,1
    AAP 7,2

    WAIT TICKS,0,10

    // Read resting encoder positions WITHOUT zeroing first.
    // Syncs actual (AP1) and target (AP0) to the same physical position
    // so the closed-loop PID sees zero error on activation — no snap.
    GAP 209,0
    AAP 1,0
    AAP 0,0

    GAP 209,1
    AAP 1,1
    AAP 0,1

    GAP 209,2
    AAP 1,2
    AAP 0,2

    WAIT TICKS,0,10

    SGP 10, 2, 0
    JA MainLoop


// ========================================================================
// 2. START INIT
// ========================================================================

StartInit:

    GGP CLgamma_Vmin, 2
    AAP 108,0
    AAP 108,1
    AAP 108,2

    GGP CLgamma_Vmax, 2
    AAP 109,0
    AAP 109,1
    AAP 109,2

    GGP CL_Maxgamma, 2
    AAP 110,0
    AAP 110,1
    AAP 110,2

    GGP CL_Beta, 2
    AAP 111,0
    AAP 111,1
    AAP 111,2

    GGP CL_Currentmin, 2
    AAP 113,0
    AAP 113,1
    AAP 113,2

    GGP CL_Currentmax, 2
    AAP 114,0
    AAP 114,1
    AAP 114,2

    GGP CL_Startup, 2
    AAP 126,0
    AAP 126,1
    AAP 126,2

    GGP CLmax_Correction_Tolerance, 2
    AAP 125,0
    AAP 125,1
    AAP 125,2

    GGP Pos_Window, 2
    AAP 134,0
    AAP 134,1
    AAP 134,2

    GGP CL_Upscale_Delay, 2
    AAP 120,0
    AAP 120,1
    AAP 120,2

    GGP CL_Downscale_Delay, 2
    AAP 121,0
    AAP 121,1
    AAP 121,2

    GGP CL_Correction_VelocityP, 2
    AAP 115,0
    AAP 115,1
    AAP 115,2

    GGP CL_Correction_VelocityI, 2
    AAP 116,0
    AAP 116,1
    AAP 116,2

    GGP CL_Correction_VelocityI_Clipping, 2
    AAP 117,0
    AAP 117,1
    AAP 117,2

    GGP CL_Correction_VelocityDV_Clock, 2
    AAP 118,0
    AAP 118,1
    AAP 118,2

    GGP CL_Correction_VelocityDV_Clipping, 2
    AAP 119,0
    AAP 119,1
    AAP 119,2

    GGP CL_Correction_Pos, 2
    AAP 124,0
    AAP 124,1
    AAP 124,2

    GGP Max_Encoder_Deviation, 2
    AAP 212,0
    AAP 212,1
    AAP 212,2

    GGP Max_Velocity_Deviation, 2
    AAP 213,0
    AAP 213,1
    AAP 213,2

    WAIT TICKS,0,10

    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 3. DISABLE CLOSED LOOP
// ========================================================================
        
DisableClosedLoop:

    SAP 129,0,0
    SAP 129,1,0
    SAP 129,2,0

    WaitDisableClosedLoop:

        WAIT TICKS,0,1
        GAP 133,0
        COMP 0
        JC NE, WaitDisableClosedLoop

        WAIT TICKS,0,1
        GAP 133,1
        COMP 0
        JC NE, WaitDisableClosedLoop

        WAIT TICKS,0,1
        GAP 133,2
        COMP 0
        JC NE, WaitDisableClosedLoop

    WAIT TICKS,0,20
        
    SGP 10, 2, 0
    JA MainLoop

DisableClosedLoop_Routine:

    SAP 129,0,0
    SAP 129,1,0
    SAP 129,2,0

    WaitDisableClosedLoop_Routine:

    WAIT TICKS,0,1
    GAP 133,0
    COMP 0
    JC NE, WaitDisableClosedLoop_Routine

    WAIT TICKS,0,1
    GAP 133,1
    COMP 0
    JC NE, WaitDisableClosedLoop_Routine

    WAIT TICKS,0,1
    GAP 133,2
    COMP 0
    JC NE, WaitDisableClosedLoop_Routine

    WAIT TICKS,0,20

    RSUB

EnableClosedLoop_Routine:

    SAP 129,0,1
    SAP 129,1,1
    SAP 129,2,1

    WaitEnableClosedLoop_Routine:

    WAIT TICKS,0,1
    GAP 133,0
    COMP 1
    JC NE, WaitEnableClosedLoop_Routine

    WAIT TICKS,0,1
    GAP 133,1
    COMP 1
    JC NE, WaitEnableClosedLoop_Routine

    WAIT TICKS,0,1
    GAP 133,2
    COMP 1
    JC NE, WaitEnableClosedLoop_Routine

    WAIT TICKS,0,20

    RSUB

// ========================================================================
// 4. ENABLE CLOSED LOOP
// ========================================================================
        
EnableClosedLoop:

    SAP 129,0,1
    SAP 129,1,1
    SAP 129,2,1

    WaitEnableClosedLoop:

        WAIT TICKS,0,1
        GAP 133,0
        COMP 1
        JC NE, WaitEnableClosedLoop

        WAIT TICKS,0,1
        GAP 133,1
        COMP 1
        JC NE, WaitEnableClosedLoop

        WAIT TICKS,0,1
        GAP 133,2
        COMP 1
        JC NE, WaitEnableClosedLoop

    WAIT TICKS,0,20

    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 5. REFERENCE ZERO
// ========================================================================

ReferenceZero:

    SAP 209,0,0
    SAP 209,1,0
    SAP 209,2,0

    GAP 209,0
    AAP 1,0

    GAP 209,1
    AAP 1,1

    GAP 209,2
    AAP 1,2

    GAP 209,0
    AAP 0,0

    GAP 209,1
    AAP 0,1

    GAP 209,2
    AAP 0,2

WAIT TICKS,0,10
SGP 10, 2, 0   
JA MainLoop

// ========================================================================
// 6. START CALIBRATION AXIS 0
// ========================================================================
StartCalibrationAxis0:
    SCO 0,0,4000000
    MVP COORD,0,0
    WAIT TICKS,0,100
CalibAxis0Stop:
    WAIT TICKS,0,1
    GAP 3,0
    COMP 0
    JC NE, CalibAxis0Stop
    MST 0
    GAP 209,0
    AAP 0,0                      // sync CL target to block — stops motor fighting block
    AGP CALIB_POS_AXIS0,2        // CALIB_POS_AXIS0 = encoder pos at block

SGP 10, 2, 0
JA MainLoop

// ========================================================================
// 7. START CALIBRATION AXIS 1
// ========================================================================
StartCalibrationAxis1:
    SCO 0,1,4000000
    MVP COORD,1,0
    WAIT TICKS,0,100
CalibAxis1Stop:
    WAIT TICKS,0,1
    GAP 3,1
    COMP 0
    JC NE, CalibAxis1Stop
    MST 1
    GAP 209,1
    AAP 0,1                      // sync CL target to block — stops motor fighting block
    AGP CALIB_POS_AXIS1,2        // CALIB_POS_AXIS1 = encoder pos at block

SGP 10, 2, 0
JA MainLoop

// ========================================================================
// 8. START CALIBRATION AXIS 2
// ========================================================================
StartCalibrationAxis2:
   SCO 0,2,4000000
    MVP COORD,2,0
    WAIT TICKS,0,100
CalibAxis2Stop:
    WAIT TICKS,0,1
    GAP 3,2
   COMP 0
    JC NE, CalibAxis2Stop
    MST 2
    GAP 209,2
    AAP 0,2                      // sync CL target to block — stops motor fighting block
    AGP CALIB_POS_AXIS2,2        // CALIB_POS_AXIS2 = encoder pos at copper block

SGP 10, 2, 0
JA MainLoop

// ========================================================================
// 9. START MOVE
// ========================================================================

StartMove:

    GGP Max_Speed, 2
    AAP 4,0
    AAP 4,1
    AAP 4,2

    // Absolute targets pre-computed by Julia (calib_pos_n - offset) and
    // written to GP 59/60/61 before triggering this command.
    GGP MOVE_TARGET_AXIS0, 2
    ACO 0,0

    GGP MOVE_TARGET_AXIS1, 2
    ACO 0,1

    GGP MOVE_TARGET_AXIS2, 2
    ACO 0,2

    MVP COORD,0,0
    MVP COORD,1,0
    MVP COORD,2,0

MonitorLoop:

    // Axis 0: if target not reached, check velocity — zero means unexpected stop
    GAP 8,0
    COMP 1
    JC EQ, CheckAxis1
    GAP 3,0
    COMP 0
    JC EQ, StopAllAxes

CheckAxis1:
    // Axis 1
    GAP 8,1
    COMP 1
    JC EQ, CheckAxis2
    GAP 3,1
    COMP 0
    JC EQ, StopAllAxes

CheckAxis2:
    // Axis 2
    GAP 8,2
    COMP 1
    JC EQ, CheckAllDone
    GAP 3,2
    COMP 0
    JC EQ, StopAllAxes

ContinueLoop:
    WAIT TICKS,0,1
    JA MonitorLoop

StopAllAxes:
    SAP 17,0, 1000000          // boost deceleration for fast controlled stop
    SAP 17,1, 1000000
    SAP 17,2, 1000000
    MST 0
    MST 1
    MST 2
WaitStop0:
    GAP 3,0
    COMP 0
    JC NE, WaitStop0
WaitStop1:
    GAP 3,1
    COMP 0
    JC NE, WaitStop1
WaitStop2:
    GAP 3,2
    COMP 0
    JC NE, WaitStop2
    WAIT TICKS,0,20            // mechanical settling
    AAP 17,0                   // restore normal deceleration from GP_MAX_DECELERATION
    AAP 17,1
    AAP 17,2
    GAP 209,0                  // sync ramp and CL target to actual position
    AAP 1,0
    AAP 0,0
    GAP 209,1
    AAP 1,1
    AAP 0,1
    GAP 209,2
    AAP 1,2
    AAP 0,2
    SGP 10, 2, 0
    JA MainLoop

CheckAllDone:
    GAP 8,0
    COMP 1
    JC NE, ContinueLoop

    GAP 8,1
    COMP 1
    JC NE, ContinueLoop

    GAP 8,2
    COMP 1
    JC NE, ContinueLoop

    SGP 10, 2, 0
    JA MainLoop

// =====================================================
// STOP EVERYTHING
// =====================================================
EmergencyStop:

    SAP 17,0, 1000000
    SAP 17,1, 1000000
    SAP 17,2, 1000000

    MST 0
    MST 1
    MST 2

// -----------------------------------------------------
// WAIT UNTIL ALL AXES ARE REALLY STOPPED
// -----------------------------------------------------
WaitAxis0Stopped:
    GAP 3,0
    COMP 0
    JC NE,WaitAxis0Stopped

WaitAxis1Stopped:
    GAP 3,1
    COMP 0
    JC NE,WaitAxis1Stopped

WaitAxis2Stopped:
    GAP 3,2
    COMP 0
    JC NE,WaitAxis2Stopped

    WAIT TICKS,0,20         // mechanical settling

    CSUB RecoverDeceleration
    SGP 10, 2, 99
    JA MainLoop

RecoverDeceleration:
    GGP Max_Deceleration, 2
    AAP 17,0
    AAP 17,1
    AAP 17,2
    RSUB

// ========================================================================
// 10. POWER OFF
// ========================================================================

PowerOff:
    
    MST 0                   // Motor STop Axis 0
    MST 1                   // Motor STop Axis 1
    MST 2                   // Motor STop Axis 2
    WAIT TICKS,0,10
    CSUB DisableClosedLoop_Routine
    SAP 6, 0, 0
    SAP 6, 1, 0
    SAP 6, 2, 0
    SAP 7, 0, 0
    SAP 7, 1, 0
    SAP 7, 2, 0

   WAIT TICKS,0,10
   SGP 10, 2, 0
   JA MainLoop

 // ========================================================================
// 11. ENTER MEASUREMENT MODE
// ========================================================================

EnterMeasurementMode:

    MST 0
    MST 1
    MST 2

    // Sync target to actual so CL sees zero error when re-enabled
    GAP 209,0
    AAP 0,0

    GAP 209,1
    AAP 0,1

    GAP 209,2
    AAP 0,2

    // Flush CL I-term: disable (~50ms) resets the integrator accumulated during
    // any hard stop. All CL parameters and gains are unchanged — only the
    // integrator state is cleared. Self-locking lead screws won't drift in 50ms.
    CSUB DisableClosedLoop_Routine

    // Immediately re-enable CL: I-term=0, target=actual → commands ~0 corrections
    CSUB EnableClosedLoop_Routine

    WAIT TICKS,0,50         // CL settles before zeroing current

    SAP 6,0,0               // zero run current — CL active but commands 0 at this point
    SAP 6,1,0
    SAP 6,2,0
    SAP 7,0,0               // zero hold current
    SAP 7,1,0
    SAP 7,2,0

    WAIT TICKS,0,1000       // quiet measurement wait, motors fully de-energized

    SGP 10, 2, 0
    JA MainLoop

// =====================================================
// 12. Restore motion system after measurement.
// Re-syncs target in case sleds drifted during
// measurement before re-energizing — no jerk.
// =====================================================
ExitMeasurementMode:

    // Sync both the ramp generator (AP 1) and target (AP 0) to the encoder.
    // Without AAP 1, the ramp output diverges from the encoder during de-energization
    // and CL fights to reconcile them on restore, causing oscillation on the next move.
    GAP 209,0
    AAP 1,0
    AAP 0,0

    GAP 209,1
    AAP 1,1
    AAP 0,1

    GAP 209,2
    AAP 1,2
    AAP 0,2

    GGP Max_Current, 2
    SAP 6,0,25
    SAP 6,1,25
    SAP 6,2,25

    GGP Standby_Current, 2
    SAP 7,0,8
    SAP 7,1,8
    SAP 7,2,8

    WAIT TICKS,0,50         // wait for CL to stabilise at current position

    SGP 10, 2, 0
    JA MainLoop

       
// ========================================================================
// 13. MOVE AXIS 0 TO ABSOLUTE POSITION
// Julia writes absolute encoder target to GP 0 before sending state 13.
// Other axes are held by their self-locking spindles. Use for re-leveling.
// ========================================================================
MoveAxis0:
    GGP Max_Speed, 2
    AAP 4,0
    GGP Target_Pos, 2
    ACO 0,0
    MVP COORD,0,0
    WAIT TICKS,0,10             // let AP 8 clear before first poll
MonitorAxis0Loop:
    GAP 8,0
    COMP 1
    JC EQ, DoneAxis0
    GAP 3,0
    COMP 0
    JC EQ, HardStopAxis0        // velocity=0 but not at target → hard stop
    WAIT TICKS,0,1
    JA MonitorAxis0Loop
HardStopAxis0:
    MST 0
    GAP 209,0
    AAP 1,0
    AAP 0,0                     // sync ramp and CL target to actual position
    SGP 10, 2, 0
    JA MainLoop
DoneAxis0:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 14. MOVE AXIS 1 TO ABSOLUTE POSITION
// ========================================================================
MoveAxis1:
    GGP Max_Speed, 2
    AAP 4,1
    GGP Target_Pos, 2
    ACO 0,1
    MVP COORD,1,0
    WAIT TICKS,0,10
MonitorAxis1Loop:
    GAP 8,1
    COMP 1
    JC EQ, DoneAxis1
    GAP 3,1
    COMP 0
    JC EQ, HardStopAxis1
    WAIT TICKS,0,1
    JA MonitorAxis1Loop
HardStopAxis1:
    MST 1
    GAP 209,1
    AAP 1,1
    AAP 0,1
    SGP 10, 2, 0
    JA MainLoop
DoneAxis1:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 15. MOVE AXIS 2 TO ABSOLUTE POSITION
// ========================================================================
MoveAxis2:
    GGP Max_Speed, 2
    AAP 4,2
    GGP Target_Pos, 2
    ACO 0,2
    MVP COORD,2,0
    WAIT TICKS,0,10
MonitorAxis2Loop:
    GAP 8,2
    COMP 1
    JC EQ, DoneAxis2
    GAP 3,2
    COMP 0
    JC EQ, HardStopAxis2
    WAIT TICKS,0,1
    JA MonitorAxis2Loop
HardStopAxis2:
    MST 2
    GAP 209,2
    AAP 1,2
    AAP 0,2
    SGP 10, 2, 0
    JA MainLoop
DoneAxis2:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 16. SIMULTANEOUS CALIBRATION
// All 3 axes descend toward the calibration blocks together.
// Each axis is monitored independently in a round-robin poll loop.
// When an axis stalls (velocity = 0 before reaching position 1,000,000),
// it is MST'd immediately and its encoder position saved to CALIB_POS.
// Done flags in GP 56/57/58 prevent re-triggering once an axis is saved.
// Completes normally with GP10=0 when all 3 positions are saved.
// This matches the behaviour of StartCalibrationSimultaneousAxis in
// FullTest_CreatorMode.tmc.
// ========================================================================
SimultaneousCalibration:

    GGP Max_Speed, 2
    AAP 4,0
    AAP 4,1
    AAP 4,2

    SCO 0,0,4000000
    SCO 0,1,4000000
    SCO 0,2,4000000

    MVP COORD,0,0
    MVP COORD,1,0
    MVP COORD,2,0

    WAIT TICKS,0,100        // let all 3 motors begin moving before polling

    CALC LOAD,0
    AGP CALIB_DONE_AXIS0,2  // axis0Done = 0
    AGP CALIB_DONE_AXIS1,2  // axis1Done = 0
    AGP CALIB_DONE_AXIS2,2  // axis2Done = 0

CalibSimLoop:

    //---------- AXIS 0
    GGP CALIB_DONE_AXIS0,2
    COMP 1
    JC EQ, CalibSimCheck1   // already done, skip

    GAP 3,0                 // read actual velocity
    COMP 0
    JC NE, CalibSimCheck1   // still moving, skip

    MST 0
    GAP 209,0
    AAP 0,0                 // sync CL target to block — stops motor fighting block
    AGP CALIB_POS_AXIS0,2   // CALIB_POS_AXIS0 = encoder pos at block
    CALC LOAD,1
    AGP CALIB_DONE_AXIS0,2  // axis0Done = 1

CalibSimCheck1:
    //---------- AXIS 1
    GGP CALIB_DONE_AXIS1,2
    COMP 1
    JC EQ, CalibSimCheck2   // already done, skip

    GAP 3,1
    COMP 0
    JC NE, CalibSimCheck2   // still moving, skip

    MST 1
    GAP 209,1
    AAP 0,1                 // sync CL target to block — stops motor fighting block
    AGP CALIB_POS_AXIS1,2   // CALIB_POS_AXIS1 = encoder pos at block
    CALC LOAD,1
    AGP CALIB_DONE_AXIS1,2  // axis1Done = 1

CalibSimCheck2:
    //---------- AXIS 2
    GGP CALIB_DONE_AXIS2,2
    COMP 1
    JC EQ, CalibSimAllCheck // already done, skip

    GAP 3,2
    COMP 0
    JC NE, CalibSimAllCheck // still moving, skip

    MST 2
    GAP 209,2
    AAP 0,2                 // sync CL target to block — stops motor fighting block
    AGP CALIB_POS_AXIS2,2   // CALIB_POS_AXIS2 = encoder pos at block
    CALC LOAD,1
    AGP CALIB_DONE_AXIS2,2  // axis2Done = 1

CalibSimAllCheck:
    GGP CALIB_DONE_AXIS0,2
    COMP 1
    JC NE, CalibSimWait

    GGP CALIB_DONE_AXIS1,2
    COMP 1
    JC NE, CalibSimWait

    GGP CALIB_DONE_AXIS2,2
    COMP 1
    JC EQ, CalibSimDone

CalibSimWait:
    WAIT TICKS,0,1
    JA CalibSimLoop

CalibSimDone:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 17. MOVE AXIS 0 ABOVE CALIBRATION POINT
//     Julia writes abs target (CALIB_POS_AXIS0 − offset) to MOVE_TARGET_AXIS0 (GP59) before triggering.
// ========================================================================
MoveAxis0AboveCalib:
    GGP Max_Speed, 2
    AAP 4,0
    GGP MOVE_TARGET_AXIS0, 2
    ACO 0,0
    MVP COORD,0,0
    WAIT TICKS,0,10             // let AP 8 clear before first poll
MonitorAxis0AboveLoop:
    GAP 8,0
    COMP 1
    JC EQ, DoneAxis0Above
    GAP 3,0
    COMP 0
    JC EQ, HardStopAxis0Above   // velocity=0 but not at target → hard stop
    WAIT TICKS,0,1
    JA MonitorAxis0AboveLoop
HardStopAxis0Above:
    MST 0
    GAP 209,0
    AAP 0,0                     // sync CL target to current position so CL stops fighting
    SAP 129,0,0                 // disable CL on axis 0 to flush I-term
    WAIT TICKS,0,50
    SAP 129,0,1                 // re-enable CL with clean integrator
    WAIT TICKS,0,20
    SGP 10, 2, 0
    JA MainLoop
DoneAxis0Above:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 18. MOVE AXIS 1 ABOVE CALIBRATION POINT
//     Julia writes abs target (CALIB_POS_AXIS1 − offset) to MOVE_TARGET_AXIS1 (GP60) before triggering.
// ========================================================================
MoveAxis1AboveCalib:
    GGP Max_Speed, 2
    AAP 4,1
    GGP MOVE_TARGET_AXIS1, 2
    ACO 0,1
    MVP COORD,1,0
    WAIT TICKS,0,10             // let AP 8 clear before first poll
MonitorAxis1AboveLoop:
    GAP 8,1
    COMP 1
    JC EQ, DoneAxis1Above
    GAP 3,1
    COMP 0
    JC EQ, HardStopAxis1Above   // velocity=0 but not at target → hard stop
    WAIT TICKS,0,1
    JA MonitorAxis1AboveLoop
HardStopAxis1Above:
    MST 1
    GAP 209,1
    AAP 0,1                     // sync CL target to current position so CL stops fighting
    SAP 129,1,0                 // disable CL on axis 1 to flush I-term
    WAIT TICKS,0,50
    SAP 129,1,1                 // re-enable CL with clean integrator
    WAIT TICKS,0,20
    SGP 10, 2, 0
    JA MainLoop
DoneAxis1Above:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 19. MOVE AXIS 2 ABOVE CALIBRATION POINT
//     Julia writes abs target (CALIB_POS_AXIS2 − offset) to MOVE_TARGET_AXIS2 (GP61) before triggering.
// ========================================================================
MoveAxis2AboveCalib:
    GGP Max_Speed, 2
    AAP 4,2
    GGP MOVE_TARGET_AXIS2, 2
    ACO 0,2
    MVP COORD,2,0
    WAIT TICKS,0,10             // let AP 8 clear before first poll
MonitorAxis2AboveLoop:
    GAP 8,2
    COMP 1
    JC EQ, DoneAxis2Above
    GAP 3,2
    COMP 0
    JC EQ, HardStopAxis2Above   // velocity=0 but not at target → hard stop
    WAIT TICKS,0,1
    JA MonitorAxis2AboveLoop
HardStopAxis2Above:
    MST 2
    GAP 209,2
    AAP 0,2                     // sync CL target to current position so CL stops fighting
    SAP 129,2,0                 // disable CL on axis 2 to flush I-term
    WAIT TICKS,0,50
    SAP 129,2,1                 // re-enable CL with clean integrator
    WAIT TICKS,0,20
    SGP 10, 2, 0
    JA MainLoop
DoneAxis2Above:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 100. PING — no-op; clears GP10 so Julia can confirm the program is running
// ========================================================================
Ping:
    SGP 10, 2, 0
    JA MainLoop

// ========================================================================
// 999. END LOOP OF TMCM PROGRAM - SOP FIRMWARE
// ========================================================================

EndLoop:

    MST 0
    MST 1
    MST 2
    STOP                     // Stops execution of the TMCL program



























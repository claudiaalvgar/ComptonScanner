JA Main

// =====================================================
// MAIN
// =====================================================
Main:
    //CSUB ReferenceZero
    //CSUB StartCalibration // 2nd ONE MOTOR AT A TIME : Move each axis separately until one of them hit the metal block and it hard stops
    //CSUB ReferenceZero    // 3rd Set the actual motor position and encoder position to 0 - Reference position
STOP

// =====================================================
// START MOVE
// =====================================================
StartCalibration:

    // Move up
    //SCO 0,0,-100000
    //MVP COORD,0,0

    //SCO 0,1,-100000
    //MVP COORD,1,0

    //SCO 0,2,-100000
    //MVP COORD,2,0

    // Move down
    SCO 0,0,100000
    MVP COORD,0,0

    //SCO 0,1,100000
    //MVP COORD,1,0

    //SCO 0,2,100000
    //MVP COORD,2,0

RSUB

// =====================================================
// REFERENCE ZERO
// =====================================================
ReferenceZero:

    SAP 209,0,0
    SAP 209,1,0
    SAP 209,2,0

    GAP 209,0
    AAP 1,0

    GAP 209,1
    AAP 1,1

    GAP 209,2
    AAP 1,2

    GAP 209,0
    AAP 0,0

    GAP 209,1
    AAP 0,1

    GAP 209,2
    AAP 0,2

    WAIT TICKS,0,10
RSUB


//    MST 2

RSUB


PowerOff:
    MST 0                   // Motor STop Axis 0
    MST 1                   // Motor STop Axis 1
    MST 2                   // Motor STop Axis 2
    WAIT TICKS,0,10
    CSUB DisableClosedLoop
    SAP 6, 0, 0
    SAP 6, 1, 0
    SAP 6, 2, 0
    SAP 7, 0, 0
    SAP 7, 1, 0
    SAP 7, 2, 0
RSUB


// =====================================================
// De-energize motors for detector data acquisition.
// SAP 6=0 (run current) and SAP 7=0 (hold current)
// stop all PWM switching and EMI without touching CL
// state or calibration. SAP 204 freewheeling modes
// require StealthChop + SAP 7=0 as prerequisites and
// have no effect in the current configuration.
// =====================================================
EnterMeasurementMode:

    MST 0
    MST 1
    MST 2

WaitAxis0Stopped_M:
    GAP 3,0
    COMP 0
    JC NE,WaitAxis0Stopped_M

WaitAxis1Stopped_M:
    GAP 3,1
    COMP 0
    JC NE,WaitAxis1Stopped_M

WaitAxis2Stopped_M:
    GAP 3,2
    COMP 0
    JC NE,WaitAxis2Stopped_M

    WAIT TICKS,0,50         // mechanical settling

    // Sync target to current position before de-energizing
    // so CL does not fight to return to old move target on restore
    GAP 209,0
    AAP 0,0

    GAP 209,1
    AAP 0,1

    GAP 209,2
    AAP 0,2

    SAP 6,0,0               // zero run current — stops all PWM switching
    SAP 6,1,0
    SAP 6,2,0
    SAP 7,0,0               // zero hold current
    SAP 7,1,0
    SAP 7,2,0

    WAIT TICKS,0,100        // electrical settling before measurement

RSUB

// =====================================================
// Restore motion system after measurement.
// Re-syncs target in case sleds drifted during
// measurement before re-energizing — no jerk.
// =====================================================
ExitMeasurementMode:

    // Re-sync target in case of drift during measurement
    GAP 209,0
    AAP 0,0

    GAP 209,1
    AAP 0,1

    GAP 209,2
    AAP 0,2

    SAP 6,0,25              // restore run current
    SAP 6,1,25
    SAP 6,2,25
    SAP 7,0,8               // restore hold current
    SAP 7,1,8
    SAP 7,2,8

    WAIT TICKS,0,50         // wait for CL to stabilise at current position

RSUB